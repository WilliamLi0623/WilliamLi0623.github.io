<div class="home-section education">
  <table class="table table-sm table-borderless">
    {% for edu in site.data.resume.education %}
      <tr>
        <th scope="row" class="home-date">
          {{ edu.startDate | date: '%b %Y' }} –
          {% if edu.endDate %}{{ edu.endDate | date: '%b %Y' }}{% else %}Present{% endif %}
        </th>
        <td>
          <a href="{{ edu.url }}"
            ><b>{{ edu.institution }}</b></a
          >
          <span class="home-meta">· {{ edu.location }}</span>
          <br>
          {{ edu.studyType }}, <i>{{ edu.area }}</i>
        </td>
      </tr>
    {% endfor %}
  </table>
</div>
